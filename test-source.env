# =============================================================================
# Throwaway single-node Kafka broker to use as a TEST SOURCE for MirrorMaker.
# It runs as its own container, outside Docker Compose. Start it from this
# folder, after "docker compose up -d sage-kafka" has created the network:
#
#   docker run -d --rm --name test-source-kafka --hostname test-source-kafka \
#     --network kafka-mirror -p 127.0.0.1:29092:29092 \
#     --env-file test-source.env apache/kafka:4.3.1
#
# Stop it with "docker stop test-source-kafka". Because of --rm, the container
# and all its data are deleted when it stops.
#
# Docker env-file rules: one KEY=value per line, no quotes (they'd become part
# of the value), and comments only on their own lines.
# =============================================================================

# KRaft: one node acting as both broker and controller.
CLUSTER_ID=hKv8uMFoRKCIrIjK25klPA
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@test-source-kafka:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

# PLAINTEXT is for MirrorMaker and other containers on the kafka-mirror network.
# EXTERNAL is for tools on your machine, at localhost:29092.
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:29092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://test-source-kafka:9092,EXTERNAL://localhost:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT

# One broker, so Kafka's internal topics can only have one replica.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# Data lives inside the container and disappears with it.
KAFKA_LOG_DIRS=/tmp/kraft-combined-logs
